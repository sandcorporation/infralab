# Notify config of the mail bridge (bridge.sh). Copy it outside the repository, fill it in and point
# BRIDGE_NOTIFY_ENV at it (default ~/.config/<name>-factory-bridge/bridge-notify.env). It is read as
# KEY=value lines, never sourced. Keep the values out of the repository.

# The coordinator: its folder (the `path:` worktree selector) and its terminal's title there.
BRIDGE_COORD_WORKTREE=
BRIDGE_COORD_TITLE=

# The owner's bot: its Orca server (--on) and address (--to, e.g. bot:<name>).
BRIDGE_BOSS_ON=
BRIDGE_BOSS_TO=

# Optional: the old recipient names in the state file, moved to coord / boss on the next run
# (space- or comma-separated).
BRIDGE_LEGACY_COORD=
BRIDGE_LEGACY_BOSS=
