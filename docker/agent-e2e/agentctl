#!/bin/bash
# e2e 전용 에이전트 손잡이(#227) — 컨테이너는 그대로 두고 그 안의 에이전트 프로세스만 바꾼다.
# 컨테이너를 다시 만들면 호스트에 veth 가 새로 생기고, Chromium 이 이를 망 바뀜으로 보아 그때 진행 중인
# 요청(바로 뒤 새로 고침의 문서 요청)을 net::ERR_NETWORK_CHANGED 로 끊는다. 프로세스 교체는 망을 건드리지 않는다.
#   agentctl start   — 환경변수 AGENT_TOKEN 의 토큰으로 (다시) 띄운다
#   agentctl stop    — 내린다(학생이 실습 환경을 켜지 않은 꼴)
set -eu

stop() {
  pkill -x agent 2>/dev/null || true
  # 이전 에이전트가 7777 을 놓을 때까지 — 사건(프로세스 끝)을 기다린다.
  while pgrep -x agent >/dev/null; do sleep 0.1; done
}

case "${1:-}" in
  start)
    : "${AGENT_TOKEN:?AGENT_TOKEN 이 없다}"
    stop
    # 로그는 컨테이너 로그로(PID 1 의 stdout). setsid 로 exec 세션과 떼어 docker exec 가 곧 돌아오게 한다.
    setsid agent >/proc/1/fd/1 2>&1 </dev/null &
    ;;
  stop) stop ;;
  *) echo "사용법: agentctl start|stop" >&2; exit 2 ;;
esac
