#!/usr/bin/env bash
# Fake `go test -json` of acceptance-probe.sh (PROBE_GOTEST): for `-run ^<Test>$` prints go-<Test>.jsonl
# (real `go test -json` output), or go-build.jsonl when $FAKE_GO_BUILD is set, and appends <Test> to
# $FAKE_SEEN/gotest.runs.
here=$(cd "$(dirname "$0")" && pwd)
t=
while [ $# -gt 0 ]; do [ "$1" = -run ] && { t=${2#^}; t=${t%\$}; }; shift; done
echo "$t" >> "$FAKE_SEEN/gotest.runs"
if [ -n "${FAKE_GO_BUILD:-}" ]; then cat "$here/go-build.jsonl"; else cat "$here/go-$t.jsonl"; fi
exit 1
