#!/usr/bin/env bash
# Fake vitest for tests/acceptance-probe.sh (#492): records its arguments and the test files as it saw
# them in $FAKE_SEEN and writes $FAKE_VT (a vitest JSON report, @DIR@ standing for the directory it
# runs in) to the --outputFile. Exits 1.
pwd > "$FAKE_SEEN/vitest.cwd"
printf '%s\n' "$*" > "$FAKE_SEEN/vitest.args"
: > "$FAKE_SEEN/vitest.files"
out=
for a in "$@"; do
  case "$a" in
    --outputFile=*) out=${a#--outputFile=} ;;
    -*) ;;
    *) [ -f "$a" ] && cat "$a" >> "$FAKE_SEEN/vitest.files" ;;
  esac
done
[ -n "${FAKE_VT:-}" ] && [ -n "$out" ] && sed "s#@DIR@#$PWD#g" "$FAKE_VT" > "$out"
echo "fake vitest output"
exit 1
