#!/usr/bin/env bash
# Fake pytest for tests/acceptance-probe.sh (#492): records where and how it ran and the test files as
# it saw them (skip markers lifted?) in $FAKE_SEEN, copies $FAKE_PY (JSON lines the probe_pytest plugin
# would write) to $PROBE_OUT and exits $FAKE_PY_EXIT (default 1).
pwd > "$FAKE_SEEN/pytest.cwd"
printf '%s\n' "$*" > "$FAKE_SEEN/pytest.args"
: > "$FAKE_SEEN/pytest.files"
for a in "$@"; do
  case "$a" in -*) ;; *) [ -f "$a" ] && cat "$a" >> "$FAKE_SEEN/pytest.files" ;; esac
done
[ -n "${FAKE_PY:-}" ] && cat "$FAKE_PY" >> "$PROBE_OUT"
echo "fake pytest output"
exit "${FAKE_PY_EXIT:-1}"
