#!/usr/bin/env bash
# Fake scripts/pr-merge.sh for the factory tests (FACTORY_PR_MERGE, merge-pr.sh): exit 1 while
# $FAKE_GH/checks-red exists (a red check), otherwise squash-merge through the fake gh and exit 5 when
# that is refused ($FAKE_GH/fail-merge). Each call is logged as `pr-merge <PR>` in calls.log.
d=${FAKE_GH:?FAKE_GH is not set}
echo "pr-merge $1" >> "$d/calls.log"
[ -e "$d/checks-red" ] && { echo "pr-merge: PR #$1 실패한 검사 — 병합하지 않는다: backend FAILURE" >&2; exit 1; }
gh api -X PUT "repos/$REPO/pulls/$1/merge" -f merge_method=squash > /dev/null || exit 5
